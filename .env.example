NODE_ENV=development
API_PORT=4000
REALTIME_PORT=4001
# Development defaults. Production must provide explicit managed-service values.
MONGO_URI=mongodb://localhost:27018/campusconnection?replicaSet=rs0&directConnection=true
MONGO_DB_NAME=campusconnection
REDIS_URL=redis://localhost:6380
CORS_ORIGINS=http://localhost:5173
WEB_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
VITE_REALTIME_URL=http://localhost:4001
LOG_LEVEL=info
REQUEST_TIMEOUT_MS=10000

# JWT keys are required in production as inline RSA PEM values. Render may use
# escaped \n values. Development/test generate an ephemeral RSA key pair when
# these placeholders are empty, or can use local *_FILE values instead.
JWT_ACCESS_PRIVATE_KEY=
JWT_ACCESS_PUBLIC_KEY=
JWT_ACCESS_PRIVATE_KEY_FILE=
JWT_ACCESS_PUBLIC_KEY_FILE=
JWT_KEY_ID=cc-dev-key-1
JWT_ISSUER=campusconnection-api
JWT_AUDIENCE=campusconnection-web
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_DAYS=30
# Production must use __Host-cc_refresh; development uses cc_refresh.
REFRESH_COOKIE_NAME=cc_refresh
CSRF_COOKIE_NAME=cc_csrf
CSRF_HEADER_NAME=X-CSRF-Token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="CampusConnection <your-gmail-address>"
# Development uses SMTP. Production requires EMAIL_PROVIDER=resend and explicit API credentials.
EMAIL_PROVIDER=smtp
EMAIL_API_URL=https://api.resend.com/emails
EMAIL_API_KEY=
EMAIL_FROM="CampusConnection <noreply@your-domain.example>"
EMAIL_HTTP_TIMEOUT_MS=10000
AUTH_SIGNUP_DEV_LIMIT=10
AUTH_SIGNUP_PROD_LIMIT=5
AUTH_LOGIN_DEV_LIMIT=20
AUTH_LOGIN_PROD_LIMIT=10
AUTH_VERIFY_DEV_LIMIT=20
AUTH_VERIFY_PROD_LIMIT=10
AUTH_RESEND_DEV_LIMIT=5
AUTH_RESEND_PROD_LIMIT=3

# Phase 5 search provider. mongodb is the local deterministic fallback;
# atlas enables the MongoDB Atlas Search adapter in managed environments.
SEARCH_PROVIDER=mongodb
SEARCH_ATLAS_INDEX=campusconnection_search_v1
SEARCH_FALLBACK_MAX_CANDIDATES=250
SEARCH_DEV_LIMIT=300
SEARCH_PROD_LIMIT=60
AUTOCOMPLETE_DEV_LIMIT=600
AUTOCOMPLETE_PROD_LIMIT=120
MESSAGE_DEV_LIMIT=300
MESSAGE_PROD_LIMIT=60
TYPING_DEV_LIMIT=120
TYPING_PROD_LIMIT=30
REALTIME_PRESENCE_TTL_SECONDS=45

# Phase 2+ provider placeholders.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
