# Explicit QA values. The QA runner refuses to read backend/.env.
QA_MONGO_URI=mongodb://localhost:27018/campusconnection_qa?replicaSet=rs0&directConnection=true
QA_MONGO_DB_NAME=campusconnection_qa
QA_REDIS_URL=redis://localhost:6380/15
QA_API_BASE_URL=http://localhost:4000
QA_WEB_BASE_URL=http://localhost:5173
# Set only in a local ignored environment when a seeded QA account exists.

QA_TEST_EMAIL=
QA_TEST_PASSWORD=
