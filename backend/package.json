{
  "name": "@campusconnection/backend",
  "private": true,
  "version": "0.1.0",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:qa:contract": "vitest run tests/qa/contract tests/qa/security",
    "test:qa:database": "vitest run tests/qa/database",
    "test:qa:report": "vitest run tests/qa/contract tests/qa/security --reporter=json --outputFile=../test-results/qa/vitest.json",
    "test:qa:database:report": "vitest run tests/qa/database --reporter=json --outputFile=../test-results/qa/database.json",
    "lint": "eslint src tests"
  },
  "dependencies": {
    "@campusconnection/shared": "0.1.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.16.5",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "socket.io": "^4.8.1",
    "zod": "^4.0.10"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.1",
    "tsx": "^4.20.3",
    "vitest": "^3.2.4"
  }
}
